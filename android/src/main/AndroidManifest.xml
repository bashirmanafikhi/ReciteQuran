<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microphone capture (AudioRecord, 16 kHz mono PCM16). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- One-time download of zipformer_p_arabic_v3.int8.onnx on first run
         (mirrors bin/download_model.dart's remote URL; the model is then cached in the
         app's files dir and the app runs fully offline). -->
    <uses-permission android:name="android.permission.INTERNET" />

</manifest>
